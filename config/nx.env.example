# nx-rust: пример конфигурации.
#
# Скопируйте в /etc/nx-rust/nx.env (или задайте свой путь через NX_CONFIG)
# и поправьте значения. Формат: KEY=VALUE, без export и без inline-комментариев
# (всё после '=' попадёт в значение). Переменные окружения имеют приоритет
# над этим файлом.

# ── Сервер ──────────────────────────────────────────────────────────────────
# Абсолютный путь к репозиторию (нужен systemd-юнитам).
NX_SERVER_DIR=/home/user/nx-rust

# Имя, которое увидит Moonlight. По умолчанию — hostname машины.
NX_SERVER_NAME=nx-host

# PIN для первого сопряжения. Смените на свой.
NX_SERVER_PIN=1234

# Wayland-дисплей сессии: echo $WAYLAND_DISPLAY. Hyprland часто wayland-1,
# KDE Plasma Wayland — wayland-0. Можно не задавать: launch_nx.sh найдёт
# сокет сам. Для KDE X11 не нужен.
# NX_WAYLAND_DISPLAY=wayland-1

# auto = первый существующий HEADLESS-* (только Hyprland/wlroots).
# На KDE значение игнорируется: выход выбирает портал ScreenCast (Wayland)
# или x11grab снимает весь X11-экран.
NX_OUTPUT=auto

# Захват: auto | wlr | portal | x11.
#   auto   — wlr-screencopy, если compositor его умеет (Hyprland/sway);
#            иначе портал ScreenCast (KDE/GNOME Wayland) или x11grab;
#   portal — принудительно xdg-desktop-portal + PipeWire (KDE Wayland);
#   x11    — принудительно ffmpeg x11grab (KDE Plasma X11);
#   wlr    — принудительно zwlr-screencopy.
NX_CAPTURE=auto

# Видео: 16 Мбит/с, H.264 High, 60 fps (fps задаёт клиент).
NX_BITRATE_KBPS=16000
# vaapi = in-process VA-API (только wlr-screencopy, dmabuf);
# на KDE портал/X11 всегда идут через ffmpeg (BGRA из памяти).
# Если не задавать, launch_nx.sh выберет vaapi на Hyprland и ffmpeg на KDE/X11.
# NX_ENCODER=vaapi
# auto = h264_vaapi, если vainfo подтверждает H.264 encode, иначе libx264;
# x264 = принудительно программный libx264 (NVIDIA/без VA-API).
NX_FFMPEG_ENCODER=auto
# NX_VAAPI_DEVICE=/dev/dri/renderD128
# NX_GOP=40

# Аудио: Opus 300 кбит/с, задержка 80 мс.
# Hyprland: nx_stream.monitor (роутер отправляет на стрим только нужные окна).
# KDE/GNOME: оставьте пустым — launch_nx.sh возьмёт monitor дефолтного sink'а,
# тогда планшет слышит весь звук хоста.
NX_AUDIO_BITRATE_KBPS=300
NX_AUDIO_DELAY_MS=80
# NX_AUDIO_SOURCE=nx_stream.monitor

# Лог сервера (его же читает watchdog).
# NX_SERVER_LOG=/tmp/nx-server.log

# ── USB/RNDIS watchdog (опционально, только для USB-режима) ─────────────────
# Статические адреса RNDIS-подсети. Для WiFi-режима не нужны.
NX_HOST_IP=192.168.8.1
NX_TABLET_IP=192.168.8.89
NX_TABLET_SUBNET=192.168.8.0/24
NX_USB_VENDOR=0e8d

# Пользователь сессии (Wayland/PipeWire). По умолчанию — владелец репозитория.
# NX_USER=user
# NX_UID=1000

# Личный quickshell автора; в чужом окружении оставьте пустым/не задавайте.
# NX_QUICKSHELL_UNIT=qs-shell-ii.service

# ── Модуль питания планшета (опционально) ───────────────────────────────────
# NX_POWER_LOG=/var/log/nx-tablet-power.log
# NX_POWER_STATE=/run/tablet_power.json
